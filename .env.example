# 复制本文件为 .env，并填入你的 API Key
# 获取地址：https://platform.deepseek.com （API Keys 页面创建）

DEEPSEEK_API_KEY=sk-在这里填入你的密钥

# 可选配置
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TIMEOUT=60
DEEPSEEK_MAX_RETRIES=2

# 公开部署时设为true；本地个人使用保持false
PUBLIC_DEPLOYMENT=false

# 公开版额度保护：每个浏览器会话最多主动触发5次模型流程，
# 整个服务每天最多发起120次实际模型请求
PUBLIC_SESSION_ACTION_LIMIT=5
PUBLIC_DAILY_LLM_CALL_LIMIT=120
